# Laundry Project Root .gitignore

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Backend (Laravel)
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.backup
backend/.env.production
backend/.phpunit.result.cache
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/bootstrap/cache/*.php
backend/public/storage
backend/public/hot

# Mobile App (Flutter)
mobile_app/.dart_tool/
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies
mobile_app/.packages
mobile_app/build/
mobile_app/ios/Pods/
mobile_app/ios/.symlinks/
mobile_app/ios/Flutter/Flutter.framework
mobile_app/ios/Flutter/Flutter.podspec
mobile_app/android/.gradle/
mobile_app/android/local.properties
mobile_app/android/app/release/
mobile_app/*.lock

